CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_USB_HOST_HUBS_SUPPORTED=y
# Handys schicken beim Captive-Portal-Check lange Header
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
# OTA: neue Firmware muss sich bestätigen, sonst Rückkehr zur alten
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Log-Maximum bleibt INFO: Mit DEBUG stürzt esp_vfs_select ab (IDF v6.0.2, vfs_calls.c:660 ESP_LOGD mit vfs==NULL,
# sobald /usb ausgehängt ist) - der ESP startete dann nach jedem Sync neu.
